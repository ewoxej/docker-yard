[pathes]
TRAEFIK_DATA_PATH=${DATA_PATH}/traefik
TRAEFIK_CONFIG_PATH=${TRAEFIK_DATA_PATH}/config
AUTHELIA_CONFIG_PATH=${DATA_PATH}/authelia/config
AUTHELIA_SECRETS_PATH=${DATA_PATH}/authelia/secrets
IMMICH_DATA_PATH=${DATA_PATH}/immich
DB_DATA_LOCATION=${IMMICH_DATA_PATH}/db
ML_DATA_LOCATION=${IMMICH_DATA_PATH}/cache
UPLOAD_LOCATION=/data/upload

[traefik]
*CLOUDFLARE_DNS_API_TOKEN=**********
DOCKER_HOST=tcp://docker-proxy:2375

[authelia]
TZ='Europe/Budapest'
X_AUTHELIA_CONFIG_FILTERS='template'
DOMAIN=${DOMAIN}
IMMICH_URL=photos.${DOMAIN}

[secrets]
*REDIS_HOST_PASSWORD=************


